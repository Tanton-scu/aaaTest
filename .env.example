# PriEvO-Agent GitHub-ready 版本只保留完整后端模式：
# FastAPI App + MySQL durable store + Redis notification/cache + independent Evaluation Worker。

# full 使用 MySQL + 独立 Worker；demo 使用本地 SQLite + API 进程内评估。
RUNTIME_MODE=full

# 如果使用本仓库 docker-compose.yml 启动 MySQL/Redis，保持下面两个地址即可。
DATABASE_URL=mysql+pymysql://prievo:prievo@127.0.0.1:3306/prievo
REDIS_URL=redis://127.0.0.1:6379/0

# 本机基础设施账号；docker-compose.yml 会读取这些值。
MYSQL_DATABASE=prievo
MYSQL_USER=prievo
MYSQL_PASSWORD=prievo
MYSQL_ROOT_PASSWORD=prievo-root-local
MYSQL_PORT=3306
REDIS_PORT=6379

# LLM backend：完整网页可使用真实模型或确定性 FakeLLM。
# 离线演示同时设置 RUNTIME_MODE=demo 和 LLM_BACKEND=fake，
# 此时下面的 endpoint、key、model 可以留空。
LLM_BACKEND=openai-compatible
# OpenAI-compatible LLM。火山方舟 GLM-5.2 可以直接使用 Chat Completions endpoint。
LLM_API_ENDPOINT=https://ark.cn-beijing.volces.com/api/v3/chat/completions
LLM_API_KEY=
# 也可以不填 LLM_API_KEY，改填 ARK_API_KEY；adapter 会优先读 LLM_API_KEY，再读 ARK_API_KEY。
ARK_API_KEY=
LLM_MODEL=glm-5-2-260617
LLM_TIMEOUT_SECONDS=1800
LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=0.1
LLM_THINKING_TYPE=enabled
LLM_REASONING_EFFORT=

# Run / Agent / memory 配置。
COORDINATOR_SWEEP_SECONDS=30
AGENT_MEMORY_TTL_SECONDS=86400
AGENT_MEMORY_MAX_ITEMS=40
AGENT_MEMORY_DETAILED_ITEMS=10
GENERATOR_LITERATURE_TOOL_LIMIT=3
GENERATOR_INSPECT_TOOL_LIMIT=10
REPAIR_MAX_ATTEMPTS=3
RESEARCH_FAITHFUL_MODE=false

# Literature RAG。默认保持轻量 hashing embedding，便于快速启动和单测。
# 若要启用生产级 BGE：安装 FlagEmbedding 后，把两个 backend 改成 bge。
RAG_EMBEDDING_BACKEND=hash
RAG_EMBEDDING_MODEL=BAAI/bge-m3
RAG_QUERY_INSTRUCTION=为这个查询生成表示以用于检索相关文献：
RAG_RERANKER_BACKEND=none
RAG_RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RAG_RERANK_CANDIDATE_POOL=40
RAG_BGE_USE_FP16=true
RAG_BGE_DEVICE=
RAG_RERANKER_NORMALIZE=true

# 独立评估 Worker。lease 必须大于单个候选 benchmark timeout。
EVALUATION_WORKER_ID_PREFIX=evaluation-worker
EVALUATION_TIMEOUT_SECONDS=10
EVALUATION_LEASE_SECONDS=30
EVALUATION_WORKER_POLL_SECONDS=0.25
EVALUATION_WORKER_MAX_POLL_SECONDS=2
EVALUATION_STALE_SWEEP_SECONDS=10

# 候选算法子进程执行时限制数值库线程，避免本机/容器资源被打满。
BENCHMARK_WORKER_COUNT=1
OMP_NUM_THREADS=1
OPENBLAS_NUM_THREADS=1
MKL_NUM_THREADS=1
NUMEXPR_NUM_THREADS=1
