# Full Mode 基础设施已经给出容器内默认值；通常只需填写 LLM 三项。
# Compose 会强制 app/worker 都为 full；该值供直接运行 Python CLI 时读取。
PRIEVO_MODE=full
DATABASE_URL=mysql+pymysql://prievo:prievo@mysql:3306/prievo
REDIS_URL=redis://redis:6379/0
AGENT_MEMORY_TTL_SECONDS=86400
AGENT_MEMORY_MAX_ITEMS=30
# 正常路径事件触发；此周期只为 COMMIT 后回调丢失提供 durable missing-work 兜底。
COORDINATOR_SWEEP_SECONDS=30
# true：不装配 Research；Repair 审计草案标为 INVALID，不进入 population。
RESEARCH_FAITHFUL_MODE=false
# Full Mode 独立 Evaluation Worker。当前父 Worker 只在 benchmark 前后续租，
# 没有后台 heartbeat，因此 lease 必须大于 timeout。
EVALUATION_WORKER_ID_PREFIX=evaluation-worker
EVALUATION_TIMEOUT_SECONDS=10
EVALUATION_LEASE_SECONDS=30
EVALUATION_WORKER_POLL_SECONDS=0.25
EVALUATION_WORKER_MAX_POLL_SECONDS=2
EVALUATION_STALE_SWEEP_SECONDS=10
# 仅供 scripts/full_mode_smoke.py 使用：全局截止时间与首个 Job 领取窗口；后者不得更大。
FULL_MODE_SMOKE_TIMEOUT_SECONDS=600
FULL_MODE_SMOKE_WORKER_READY_TIMEOUT_SECONDS=30
MYSQL_DATABASE=prievo
MYSQL_USER=prievo
MYSQL_PASSWORD=prievo
MYSQL_ROOT_PASSWORD=prievo-root-local

LLM_API_ENDPOINT=
LLM_API_KEY=
LLM_MODEL=

# 不填 LLM 时自动使用 deterministic FakeLLM，Dataset 主链仍可完整演示。
